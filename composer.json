{
    "name": "nataphp/app",
    "description": "NataPHP application skeleton",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/nataphp/core"
        }
    ],
    "require": {
        "php": ">=8.1",
        "nataphp/core": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TestCase\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php vendor/nataphp/core/scripts/sync-nata-assets.php"
        ],
        "post-update-cmd": [
            "@php vendor/nataphp/core/scripts/sync-nata-assets.php"
        ]
    }
}
